# Leave the Supabase variables out to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The address people use; links and redirects point here.
NEXT_PUBLIC_SITE_URL=

# Push notifications: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Sent by Vercel's scheduler to /api/cron/reminders.
CRON_SECRET=

# Optional, read only: the party portal.
PORTAL_API_URL=
PORTAL_API_KEY=
PORTAL_BRANCH_ID=
PORTAL_APP_BRANCH=
